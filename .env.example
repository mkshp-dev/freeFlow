# ==============================================================================
# Supabase Cloud Configuration
# ==============================================================================
# Find these values in your Supabase Dashboard:
# https://supabase.com/dashboard/project/<your-project-ref>/settings/api
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase API (Client & Server)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anonymous (Public) Key
# Safe to expose in client-side code (browsers/mobile apps).
# Requests using this key are governed by Supabase Row Level Security (RLS).
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Service Role (Secret) Key
# ⚠️ CRITICAL: NEVER expose this key to client-side code or public repositories!
# Used exclusively on secure server environments to bypass Row Level Security (RLS).
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 2. Framework-Specific Aliases (Uncomment depending on your frontend stack)
# ------------------------------------------------------------------------------
# Next.js:
# NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Vite:
# VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# 3. Direct PostgreSQL Database Connections (For ORMs: Prisma, Drizzle, etc.)
# ------------------------------------------------------------------------------
# Found under: Settings -> Database -> Connection string
#
# Connection Pooling URL (Recommended for serverless & edge runtimes, e.g. port 6543 / 5432 with pgbouncer):
DATABASE_URL="postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Database URL (Used for running schema migrations, e.g. Prisma Migrate, Drizzle Kit):
DIRECT_URL="postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 4. Optional / Advanced Settings
# ------------------------------------------------------------------------------
# Supabase Project Reference ID (e.g. found in dashboard URL or Settings -> General)
SUPABASE_PROJECT_ID="your-project-ref"

# JWT Secret (Found under Settings -> API -> JWT Settings; used for custom JWT verification)
SUPABASE_JWT_SECRET="your-jwt-secret"

# ------------------------------------------------------------------------------
# 5. Todoist Integration
# ------------------------------------------------------------------------------
# Todoist Personal API Token (Settings -> Integrations -> Developer in Todoist)
TODOIST_API_TOKEN=""

# Todoist Client Secret (From Todoist App Console, used to verify webhook HMAC-SHA256 signatures)
TODOIST_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 6. Cloudflare Pages Deployment
# ------------------------------------------------------------------------------
# Cloudflare API Token (Create at dash.cloudflare.com/profile/api-tokens with Pages:Edit permissions)
CLOUDFLARE_API_TOKEN=""

# Cloudflare Account ID (Found on Cloudflare dashboard overview / right sidebar)
CLOUDFLARE_ACCOUNT_ID=""


